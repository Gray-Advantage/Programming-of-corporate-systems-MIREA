    "segments": [
      {
        "id": "20000000-0000-0000-0000-000000000002",
        "orderInTextWork": 1,
        "name": "Теремок",
        "fragments": [
          {
            "id": "20000000-0000-0000-0000-000000001000",
            "orderInSegment": 1,
            "content": "Стоит в поле теремок, и пока в нём никто не живёт.",
            "voicePartId": "20000000-0000-0000-0000-000000000100"
          },
          {
            "id": "20000000-0000-0000-0000-000000001001",
            "orderInSegment": 2,
            "content": "Кто в теремочке живёт? Никого? Тогда буду жить я.",
            "voicePartId": "20000000-0000-0000-0000-000000000101"
          },
          {
            "id": "20000000-0000-0000-0000-000000001002",
            "orderInSegment": 3,
            "content": "Кто в теремочке живёт?",
            "voicePartId": "20000000-0000-0000-0000-000000000102"
          },
          {
            "id": "20000000-0000-0000-0000-000000001003",
            "orderInSegment": 4,
            "content": "Я, мышка-норушка. А ты кто?",
            "voicePartId": "20000000-0000-0000-0000-000000000101"
          },
          {
            "id": "20000000-0000-0000-0000-000000001004",
            "orderInSegment": 5,
            "content": "А я лягушка-квакушка, пусти меня к себе.",
            "voicePartId": "20000000-0000-0000-0000-000000000102"
          },
          {
            "id": "20000000-0000-0000-0000-000000001005",
            "orderInSegment": 6,
            "content": "Заходи, вдвоём веселее.",
            "voicePartId": "20000000-0000-0000-0000-000000000101"
          },
          {
            "id": "20000000-0000-0000-0000-000000001006",
            "orderInSegment": 7,
            "content": "Кто в теремочке живёт?",
            "voicePartId": "20000000-0000-0000-0000-000000000103"
          },
          {
            "id": "20000000-0000-0000-0000-000000001007",
            "orderInSegment": 8,
            "content": "Мышка-норушка да лягушка-квакушка. А ты кто?",
            "voicePartId": "20000000-0000-0000-0000-000000000102"
          },
          {
            "id": "20000000-0000-0000-0000-000000001008",
            "orderInSegment": 9,
            "content": "Я зайчик-побегайчик, пустите и меня.",
            "voicePartId": "20000000-0000-0000-0000-000000000103"
          },
          {
            "id": "20000000-0000-0000-0000-000000001009",
            "orderInSegment": 10,
            "content": "Заходи, места хватит.",
            "voicePartId": "20000000-0000-0000-0000-000000000101"
          },
          {
            "id": "20000000-0000-0000-0000-000000001010",
            "orderInSegment": 11,
            "content": "Кто в теремочке живёт?",
            "voicePartId": "20000000-0000-0000-0000-000000000104"
          },
          {
            "id": "20000000-0000-0000-0000-000000001011",
            "orderInSegment": 12,
            "content": "Мышка, лягушка да я, зайчик. А ты кто?",
            "voicePartId": "20000000-0000-0000-0000-000000000103"
          },
          {
            "id": "20000000-0000-0000-0000-000000001012",
            "orderInSegment": 13,
            "content": "Я лисичка-сестричка, пустите переночевать.",
            "voicePartId": "20000000-0000-0000-0000-000000000104"
          },
          {
            "id": "20000000-0000-0000-0000-000000001013",
            "orderInSegment": 14,
            "content": "Заходи, только не хитри.",
            "voicePartId": "20000000-0000-0000-0000-000000000101"
          },
          {
            "id": "20000000-0000-0000-0000-000000001014",
            "orderInSegment": 15,
            "content": "Кто в теремочке живёт? Пустите и меня!",
            "voicePartId": "20000000-0000-0000-0000-000000000105"
          },
          {
            "id": "20000000-0000-0000-0000-000000001015",
            "orderInSegment": 16,
            "content": "Ты слишком большой, теремок развалится.",
            "voicePartId": "20000000-0000-0000-0000-000000000104"
          },
          {
            "id": "20000000-0000-0000-0000-000000001016",
            "orderInSegment": 17,
            "content": "Я тихонько, я с краю прилягу.",
            "voicePartId": "20000000-0000-0000-0000-000000000105"
          },
          {
            "id": "20000000-0000-0000-0000-000000001017",
            "orderInSegment": 18,
            "content": "Полез медведь в теремок, и рассыпался теремок по брёвнышку.",
            "voicePartId": "20000000-0000-0000-0000-000000000100"
          },
          {
            "id": "20000000-0000-0000-0000-000000001018",
            "orderInSegment": 19,
            "content": "Не беда, построим новый, побольше.",
            "voicePartId": "20000000-0000-0000-0000-000000000101"
          },
          {
            "id": "20000000-0000-0000-0000-000000001019",
            "orderInSegment": 20,
            "content": "Я первым брёвна принесу, моя вина.",
            "voicePartId": "20000000-0000-0000-0000-000000000105"
          },
          {
            "id": "20000000-0000-0000-0000-000000001020",
            "orderInSegment": 21,
            "content": "И построили они теремок лучше прежнего.",
            "voicePartId": "20000000-0000-0000-0000-000000000100"
          }
        ]
      }
    ],

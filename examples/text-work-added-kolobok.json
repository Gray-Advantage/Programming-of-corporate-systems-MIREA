    },
    "segmentType": "SINGLE_SEGMENT",
    "segments": [
      {
        "id": "30000000-0000-0000-0000-000000000002",
        "orderInTextWork": 1,
        "name": "Колобок",
        "fragments": [
          {
            "id": "30000000-0000-0000-0000-000000001000",
            "orderInSegment": 1,
            "content": "Жили старик со старухой, и не было у них ни крошки хлеба.",
            "voicePartId": "30000000-0000-0000-0000-000000000100"
          },
          {
            "id": "30000000-0000-0000-0000-000000001001",
            "orderInSegment": 2,
            "content": "Испеки, старуха, колобок, поскреби по сусекам.",
            "voicePartId": "30000000-0000-0000-0000-000000000101"
          },
          {
            "id": "30000000-0000-0000-0000-000000001002",
            "orderInSegment": 3,
            "content": "Испеку, будет тебе колобок.",
            "voicePartId": "30000000-0000-0000-0000-000000000102"
          },
          {
            "id": "30000000-0000-0000-0000-000000001003",
            "orderInSegment": 4,
            "content": "Испекла старуха колобок и положила на окошко студиться.",
            "voicePartId": "30000000-0000-0000-0000-000000000100"
          },
          {
            "id": "30000000-0000-0000-0000-000000001004",
            "orderInSegment": 5,
            "content": "Полежал я, полежал, а теперь покачусь.",
            "voicePartId": "30000000-0000-0000-0000-000000000103"
          },
          {
            "id": "30000000-0000-0000-0000-000000001005",
            "orderInSegment": 6,
            "content": "Колобок, колобок, я тебя съем!",
            "voicePartId": "30000000-0000-0000-0000-000000000104"
          },
          {
            "id": "30000000-0000-0000-0000-000000001006",
            "orderInSegment": 7,
            "content": "Не ешь меня, я тебе песенку спою.",
            "voicePartId": "30000000-0000-0000-0000-000000000103"
          },
          {
            "id": "30000000-0000-0000-0000-000000001007",
            "orderInSegment": 8,
            "content": "Спел колобок песенку и покатился дальше.",
            "voicePartId": "30000000-0000-0000-0000-000000000100"
          },
          {
            "id": "30000000-0000-0000-0000-000000001008",
            "orderInSegment": 9,
            "content": "Колобок, колобок, я тебя съем!",
            "voicePartId": "30000000-0000-0000-0000-000000000105"
          },
          {
            "id": "30000000-0000-0000-0000-000000001009",
            "orderInSegment": 10,
            "content": "Я от бабушки ушёл и от дедушки ушёл, и от тебя уйду.",
            "voicePartId": "30000000-0000-0000-0000-000000000103"
          },
          {
            "id": "30000000-0000-0000-0000-000000001010",
            "orderInSegment": 11,
            "content": "Колобок, колобок, я тебя съем!",
            "voicePartId": "30000000-0000-0000-0000-000000000106"
          },
          {
            "id": "30000000-0000-0000-0000-000000001011",
            "orderInSegment": 12,
            "content": "Где тебе, косолапому, меня догнать.",
            "voicePartId": "30000000-0000-0000-0000-000000000103"
          },
          {
            "id": "30000000-0000-0000-0000-000000001012",
            "orderInSegment": 13,
            "content": "Какой ты румяный. Спой мне свою песенку.",
            "voicePartId": "30000000-0000-0000-0000-000000000107"
          },
          {
            "id": "30000000-0000-0000-0000-000000001013",
            "orderInSegment": 14,
            "content": "Слушай, лиса, только не перебивай.",
            "voicePartId": "30000000-0000-0000-0000-000000000103"
          },
          {
            "id": "30000000-0000-0000-0000-000000001014",
            "orderInSegment": 15,
            "content": "Стара я стала, сядь мне на носок и спой ещё разок.",
            "voicePartId": "30000000-0000-0000-0000-000000000107"
          },
          {
            "id": "30000000-0000-0000-0000-000000001015",
            "orderInSegment": 16,
            "content": "Прыгнул колобок лисе на нос, тут она его и съела.",
            "voicePartId": "30000000-0000-0000-0000-000000000100"
          },
          {
            "id": "30000000-0000-0000-0000-000000001016",
            "orderInSegment": 17,
            "content": "Говорила я, не клади его на окошко.",
            "voicePartId": "30000000-0000-0000-0000-000000000102"
          },
          {
            "id": "30000000-0000-0000-0000-000000001017",
            "orderInSegment": 18,
            "content": "Испечём завтра новый, да съедим сами.",
            "voicePartId": "30000000-0000-0000-0000-000000000101"
          }
        ]
      }
    ],

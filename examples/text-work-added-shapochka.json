    },
    "segmentType": "SINGLE_SEGMENT",
    "segments": [
      {
        "id": "10000000-0000-0000-0000-000000000002",
        "orderInTextWork": 1,
        "name": "Красная Шапочка",
        "fragments": [
          {
            "id": "10000000-0000-0000-0000-000000001000",
            "orderInSegment": 1,
            "content": "Жила в деревне девочка, и все звали её Красной Шапочкой.",
            "voicePartId": "10000000-0000-0000-0000-000000000100"
          },
          {
            "id": "10000000-0000-0000-0000-000000001001",
            "orderInSegment": 2,
            "content": "Отнеси бабушке пирожки, она приболела.",
            "voicePartId": "10000000-0000-0000-0000-000000000101"
          },
          {
            "id": "10000000-0000-0000-0000-000000001002",
            "orderInSegment": 3,
            "content": "Хорошо, мама, пойду прямо по тропинке.",
            "voicePartId": "10000000-0000-0000-0000-000000000102"
          },
          {
            "id": "10000000-0000-0000-0000-000000001003",
            "orderInSegment": 4,
            "content": "В лесу навстречу ей вышел волк.",
            "voicePartId": "10000000-0000-0000-0000-000000000100"
          },
          {
            "id": "10000000-0000-0000-0000-000000001004",
            "orderInSegment": 5,
            "content": "Куда ты идёшь, Красная Шапочка?",
            "voicePartId": "10000000-0000-0000-0000-000000000103"
          },
          {
            "id": "10000000-0000-0000-0000-000000001005",
            "orderInSegment": 6,
            "content": "К бабушке, несу ей пирожки.",
            "voicePartId": "10000000-0000-0000-0000-000000000102"
          },
          {
            "id": "10000000-0000-0000-0000-000000001006",
            "orderInSegment": 7,
            "content": "А где живёт твоя бабушка?",
            "voicePartId": "10000000-0000-0000-0000-000000000103"
          },
          {
            "id": "10000000-0000-0000-0000-000000001007",
            "orderInSegment": 8,
            "content": "За мельницей, первый дом у леса.",
            "voicePartId": "10000000-0000-0000-0000-000000000102"
          },
          {
            "id": "10000000-0000-0000-0000-000000001008",
            "orderInSegment": 9,
            "content": "Волк побежал короткой дорогой и первым добрался до домика.",
            "voicePartId": "10000000-0000-0000-0000-000000000100"
          },
          {
            "id": "10000000-0000-0000-0000-000000001009",
            "orderInSegment": 10,
            "content": "Внучка пришла, открывай!",
            "voicePartId": "10000000-0000-0000-0000-000000000103"
          },
          {
            "id": "10000000-0000-0000-0000-000000001010",
            "orderInSegment": 11,
            "content": "Дёрни за верёвочку, дверь и откроется.",
            "voicePartId": "10000000-0000-0000-0000-000000000104"
          },
          {
            "id": "10000000-0000-0000-0000-000000001011",
            "orderInSegment": 12,
            "content": "Волк запер бабушку в чулане и лёг в её постель.",
            "voicePartId": "10000000-0000-0000-0000-000000000100"
          },
          {
            "id": "10000000-0000-0000-0000-000000001012",
            "orderInSegment": 13,
            "content": "Бабушка, почему у тебя такие большие уши?",
            "voicePartId": "10000000-0000-0000-0000-000000000102"
          },
          {
            "id": "10000000-0000-0000-0000-000000001013",
            "orderInSegment": 14,
            "content": "Чтобы лучше тебя слышать.",
            "voicePartId": "10000000-0000-0000-0000-000000000103"
          },
          {
            "id": "10000000-0000-0000-0000-000000001014",
            "orderInSegment": 15,
            "content": "Бабушка, почему у тебя такие большие глаза?",
            "voicePartId": "10000000-0000-0000-0000-000000000102"
          },
          {
            "id": "10000000-0000-0000-0000-000000001015",
            "orderInSegment": 16,
            "content": "Чтобы лучше тебя видеть.",
            "voicePartId": "10000000-0000-0000-0000-000000000103"
          },
          {
            "id": "10000000-0000-0000-0000-000000001016",
            "orderInSegment": 17,
            "content": "Бабушка, почему у тебя такие большие зубы?",
            "voicePartId": "10000000-0000-0000-0000-000000000102"
          },
          {
            "id": "10000000-0000-0000-0000-000000001017",
            "orderInSegment": 18,
            "content": "Чтобы скорее тебя съесть!",
            "voicePartId": "10000000-0000-0000-0000-000000000103"
          },
          {
            "id": "10000000-0000-0000-0000-000000001018",
            "orderInSegment": 19,
            "content": "На крик прибежали дровосеки и прогнали волка прочь.",
            "voicePartId": "10000000-0000-0000-0000-000000000100"
          },
          {
            "id": "10000000-0000-0000-0000-000000001019",
            "orderInSegment": 20,
            "content": "Спасибо вам, добрые люди, что не прошли мимо.",
            "voicePartId": "10000000-0000-0000-0000-000000000104"
          },
          {
            "id": "10000000-0000-0000-0000-000000001020",
            "orderInSegment": 21,
            "content": "Больше я с незнакомцами в лесу разговаривать не стану.",
            "voicePartId": "10000000-0000-0000-0000-000000000102"
          }
        ]
      }
    ],
